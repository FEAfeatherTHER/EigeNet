{
    "model_type": "EigeNet",
    "dataset": {
        "haa_train_path": "path/to/haa_train.jsonl",
        "haa_test_path": "path/to/haa_test.jsonl",
    },
    "preprocess": {
        "sample_rate": 16000,
        "frame_rate": 50,
        "duration": 0.5,
        "max_reference_count": 8,
        },
    "model": {
        "DAC":{
            "path": "path/to/dac/weights_16k.pth"
        },
        "eigenet_transformer": {
            "hidden_size": 1024,
            "pre_dim": 512,
            "depth_resol": [256, 512],
            "depth_patch_size": [16, 16],
            "depth_channel": 3,
            "av_transformer": {
                "keep_ref": false,
                "arch": {
                    "dim": 1024,
                    "depth": 6,
                    "aa_order_list" : [["f", "g"], ["f", "g"], ["f", "g"], ["f", "g"], ["f", "g"], ["f", "g"]],
                    "heads": 16,
                    "dim_head": 64,
                    "dropout": 0.1,
                    "ff_mult": 2,
                    "qk_norm": "rms_norm",
                    "pe_attn_head": null,
                    "attn_backend": "torch",
                    "attn_mask_enabled": true,
                    "checkpoint_activations": false,
                    "return_attn": false, 
                    }
                },
            "aligner": {
                "activate": true,
                "layer": 6,
                "codebook_depth": 12,
            },
            "depth_encoder": {
            "vit_arch": {
                "dim": 512,
                "depth": 4,
                "heads": 8,
                "dim_head": 64,
                "dropout": 0.1,
                "ff_mult": 2,
                "qk_norm": "rms_norm",
                "pe_attn_head": null,
                "attn_backend": "torch",
                "attn_mask_enabled": true,
                "checkpoint_activations": false,
                "return_attn": false, 
                }
                }
            }
        },
    "loss":{
        "mrstft_loss_weight": 1.0,
        "time_edc_loss_weight": 1.0,
        "spect_edc_loss_weight": 0.0,
        "env_loss_weight": 0.0,
        "align_l1_loss_weight": 0.01,
        "align_edc_loss_weight": 0.01,
        "env":{
            "duration": 0.4,
            "smooth": "gaussian", // mv, gaussian, null
            "window": 64,
            "alpha": 0.99,
        }
    },
    "log_dir": "path/to/ckpts/EigeNet",
    "train": {
        "max_epoch": 10,
        "use_dynamic_batchsize": false,
        "max_tokens": 5000, 
        "max_sentences": 48, 
        "lr_warmup_steps": 100,
        "auxiliary_loss_warmup_steps": 200,
        "alignment_loss_warmup_steps": 200,
        "alignment_loss_start_step": 0,
        "lr_scheduler": "inverse_sqrt",
        "num_train_steps": 800000,
        "adam": {
            "lr": 1e-4
        },
        "ddp": false,
        "random_seed": 114,
        "batch_size": 16, 
        "epochs": 5000,
        "max_steps": 20000,
        "total_training_steps": 800000,
        "save_summary_steps": 80,
        "save_checkpoints_steps": 80,
        "save_checkpoints_backup_steps": 80,
        "keep_checkpoint_max": 100,
        "gradient_accumulation_step": 1,
        "resume_skip_steps": true,
        "save_checkpoint_stride": [
            1
        ],
        "keep_last": [
            3
        ],
        "run_eval": [
            false
        ],
        "dataloader": {
            "num_worker": 2,
            "pin_memory": true
        },
        "use_emilia_dataset": false
    },
    "valid":{
        "duration": 0.363,
        "batch_size": 16,
        "visualize_interval":0,
    },
    "tracker":{
        "dummy_run": true,
        "type":"swanlab",
        "project_name":"EigeNet_finetune_haa",
        "config":{
            "loss_weight":{
                "mrstft_loss_weight": 1.0,
                "time_edc_loss_weight": 1.0,
                "align_l1_loss_weight": 0.01,
                "align_edc_loss_weight": 0.01,
            },
        }
    }
}